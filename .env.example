# Copy to `.env` and adjust if desired. Every variable is optional:
# the prototype runs with built-in defaults when no .env exists.
# NOTE: `.env` is git-ignored — never commit real secrets.

# JWT signing secret. If unset, a random per-process secret is generated
# (tokens are invalidated on restart — acceptable for the demo).
SECRET_KEY=change-me-to-a-long-random-string

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLAlchemy connection string (default: seeded SQLite demo database)
DATABASE_URL=sqlite:///data/processed/sih26135.db

APP_NAME=SIH26135 Skilling Intelligence Platform

DEBUG=true
