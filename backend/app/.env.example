# SIH26135 backend configuration template.
#
# Copy this file to `.env` (same directory) and adjust values if needed.
# The prototype works fine with the built-in defaults, so a `.env` is optional.

# SQLite database URL. Default resolves to: <project_root>/data/processed/sih26135.db
# DATABASE_URL=sqlite:///E:/SIH26135/data/processed/sih26135.db

# Secret used to sign JWT tokens (Day 3 auth). Optional: if unset, a random
# secret is generated for each process. Never set a real/production secret here.
# SECRET_KEY=

# JWT algorithm + token lifetime in minutes.
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# Show debug details.
# DEBUG=true